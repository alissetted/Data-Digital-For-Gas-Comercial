[denodo]
# Opción A (recomendada): define toda la cadena ODBC
CONNECTION_STRING = "DRIVER={ODBC Driver 18 for SQL Server};SERVER=tu-servidor;DATABASE=tu-base;UID=tu-usuario;PWD=tu-password;Encrypt=Yes;TrustServerCertificate=Yes"

# Opción B (alternativa): claves separadas
# DRIVER = "ODBC Driver 18 for SQL Server"
# SERVER = "tu-servidor"
# DATABASE = "tu-base"
# UID = "tu-usuario"
# PWD = "tu-password"
# TIMEOUT = 30

[app]
# Usa "denodo" (default) o "csv"
data_source = "csv"

[csv]
# Rutas relativas al proyecto o absolutas
clientes_path = "bv_hop_registroclientes.csv"
consumos_path = "bv_hop_consumos.csv"
